#!/usr/bin/env bash
WALLPAPER_APP="quickshell"

# Colors for UI
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Ensure that cache folder exists
mkdir -p $HOME/.cache

# --- UI Functions (Redirected to stderr) ---
info() { echo -e "${GREEN}[INFO]${NC} $1" >&2; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1" >&2; }
error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

# Wallpaper app
if [ -f $HOME/.config/ml4w/settings/wallpaper-app ]; then
  WALLPAPER_APP=$(cat $HOME/.config/ml4w/settings/wallpaper-app)
fi

# Wallpaper folder
if [ -f $HOME/.config/ml4w/settings/wallpaper-folder ]; then
  RAW_FOLDER=$(cat $HOME/.config/ml4w/settings/wallpaper-folder)
  WALLPAPER_FOLDER="${RAW_FOLDER//\$HOME/$HOME}"
  WALLPAPER_FOLDER="${WALLPAPER_FOLDER//\~/$HOME}"
fi
WALLPAPER_FOLDER="/home/d4n/Wallpapers"

# Cycles the wallpaper on an interval, picking randomly from a day or
# night subfolder of $WALLPAPER_FOLDER based on the current local hour.
cycle_wallpaper() {
  local interval="${1:-10800}"

  sleep 2

  while true; do
    local hour period
    hour=$(date +%H)
    period="nocturno"
    if [ "$hour" -ge 8 ] && [ "$hour" -lt 18 ]; then
      period="diurno"
    fi

    if [ "$WALLPAPER_APP" == "quickshell" ]; then
      $HOME/.config/ml4w/scripts/ml4w-wallpaper --random "$WALLPAPER_FOLDER/$period"
    elif [ "$WALLPAPER_APP" == "waypaper" ]; then
      waypaper --random --folder "$WALLPAPER_FOLDER/$period"
    else
      error "Wallpaper App $WALLPAPER_APP not supported."
    fi

    sleep "$interval"
  done
}

# Check parameters
if [ "$1" == "--restore" ]; then
  if [ "$WALLPAPER_APP" == "quickshell" ]; then
    info "Using awww with Quickshell Wallpaper Selector."
  elif [ "$WALLPAPER_APP" == "waypaper" ]; then
    waypaper --restore
  else
    error "Wallpaper App $WALLPAPER_APP not supported."
  fi
  exit
elif [ "$1" == "--random" ]; then
  if [ "$WALLPAPER_APP" == "quickshell" ]; then
    $HOME/.config/ml4w/scripts/ml4w-wallpaper --random
  elif [ "$WALLPAPER_APP" == "waypaper" ]; then
    waypaper --random --folder $WALLPAPER_FOLDER
  else
    error "Wallpaper App $WALLPAPER_APP not supported."
  fi
  exit
elif [ "$1" == "--cycle" ]; then
  info "Starting wallpaper cycle every ${2:-10800}s from $WALLPAPER_FOLDER"
  cycle_wallpaper "$2"
  exit
fi

# Launch wallpaper app
if [ "$WALLPAPER_APP" == "quickshell" ]; then
  info "Toggle Quickshell Wallpaper App"
  qs ipc call wallpaper toggle
elif [ "$WALLPAPER_APP" == "waypaper" ]; then
  info "Launch Waypaper"
  waypaper --folder $WALLPAPER_FOLDER
else
  error "Wallpaper App $WALLPAPER_APP not supported."
fi
